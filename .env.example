APP_URL=http://localhost:3000
PORT=3000
DATABASE_URL=mysql://mailtemp_app:CHANGE_ME@127.0.0.1:3306/mailtemp
# Only used by db:setup, not the application.
MYSQL_ROOT_URL=mysql://root@127.0.0.1:3306
ADMIN_EMAIL=admin@mailtemp.local
ADMIN_PASSWORD=CHANGE_TO_A_RANDOM_PASSWORD
CRON_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
UNSUBSCRIBE_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
WEBHOOK_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
TOKEN_ENCRYPTION_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Mailtemp Travel
SMTP_REPLY_TO=
# Comma-separated internal recipients permitted for campaign test emails.
TEST_RECIPIENTS=
# For authenticated, normalized events from your email provider/inbox connector.
# Generic SMTP does not receive replies or delivery reports by itself.
REPLY_SYNC_REQUIRED=true
REPLY_SYNC_MAX_AGE_MINUTES=10

# AI assistant. Server only; never use NEXT_PUBLIC_ for API keys.
AI_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_DAILY_REQUEST_LIMIT=60
